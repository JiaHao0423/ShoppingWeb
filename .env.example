# 複製為 .env 後填入實際值（.env 不會被 Git 追蹤）
MYSQL_ROOT_PASSWORD=docker_root
MYSQL_PORT=3307
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/shopping_web?useSSL=false&serverTimezone=Asia/Taipei
SPRING_DATASOURCE_USERNAME=root
# 本機 MySQL 範例：docker_root 或你自設的 root 密碼
# Zeabur MySQL：填 Zeabur 控制台提供的密碼
SPRING_DATASOURCE_PASSWORD=docker_root
REDIS_PORT=6379
BACKEND_PORT=8080
FRONTEND_PORT=80
FRONTEND_BASE_URL=http://localhost
# Zeabur 前端網域（多個以逗號分隔）
# CORS_ALLOWED_ORIGINS=https://your-frontend.zeabur.app
